{
  "expo": {
    "name": "Zupit",
    "slug": "zupit-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#9c1c21"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#9c1c21"
      },
      "package": "com.zupit.customer"
    },
    "scheme": "zupit",
    "plugins": [
      "expo-router"
    ]
  }
}

